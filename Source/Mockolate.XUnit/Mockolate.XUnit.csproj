<Project Sdk="Microsoft.NET.Sdk">

	<!-- Prototype of a test framework integration on top of the MockDataSources hook; not published. -->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mockolate\Mockolate.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mockolate.XUnit.Tests" PublicKey="$(PublicKey)"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.extensibility.core"/>
		<PackageReference Include="Nullable">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
