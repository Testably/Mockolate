<Project>

	<!-- Generates the AutoMockArguments attribute for the test frameworks that the project references. The source
	     generator cannot decide this itself: TUnit only sees an attribute that is emitted before the compilation is
	     available. Set MockolateTestFrameworkIntegration to false to skip it. The target runs before the compile
	     dependency cache is computed, so that changing the references or the property recompiles the project. A
	     reference without a package version, e.g. to a project, is assumed to be recent enough. -->
	<Target Name="MockolateDetectTestFramework"
	        AfterTargets="ResolveAssemblyReferences"
	        Condition="'$(MockolateTestFrameworkIntegration)' != 'false' And '$(Language)' == 'C#'">
		<ItemGroup>
			<_MockolateTUnitReference Include="@(ReferencePath)"
			                          Condition="'%(ReferencePath.Filename)' == 'TUnit.Core' And ('%(ReferencePath.NuGetPackageVersion)' == '' Or $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '1.0.0')))"/>
			<_MockolateXunit2Reference Include="@(ReferencePath)"
			                           Condition="'%(ReferencePath.Filename)' == 'xunit.core' And ('%(ReferencePath.NuGetPackageVersion)' == '' Or $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '2.0.0')))"/>
			<_MockolateXunit3Reference Include="@(ReferencePath)"
			                           Condition="'%(ReferencePath.Filename)' == 'xunit.v3.core' And ('%(ReferencePath.NuGetPackageVersion)' == '' Or $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '1.0.0')))"/>
			<_MockolateNUnitReference Include="@(ReferencePath)"
			                          Condition="'%(ReferencePath.Filename)' == 'nunit.framework' And ('%(ReferencePath.NuGetPackageVersion)' == '' Or $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '3.7.0')))"/>
			<!-- MSTest v4 renamed the assembly that v1 to v3 share, so for v3 only a known version of 3.7 or later counts. -->
			<_MockolateMSTest4Reference Include="@(ReferencePath)"
			                            Condition="'%(ReferencePath.Filename)' == 'MSTest.TestFramework'"/>
			<_MockolateMSTest3Reference Include="@(ReferencePath)"
			                            Condition="'%(ReferencePath.Filename)' == 'Microsoft.VisualStudio.TestPlatform.TestFramework' And '%(ReferencePath.NuGetPackageVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('%(ReferencePath.NuGetPackageVersion)', '3.7.0'))"/>
		</ItemGroup>
		<PropertyGroup Condition="'@(_MockolateTUnitReference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_TUNIT</DefineConstants>
		</PropertyGroup>
		<PropertyGroup Condition="'@(_MockolateXunit2Reference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_XUNIT2</DefineConstants>
		</PropertyGroup>
		<PropertyGroup Condition="'@(_MockolateXunit3Reference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_XUNIT3</DefineConstants>
		</PropertyGroup>
		<PropertyGroup Condition="'@(_MockolateNUnitReference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_NUNIT</DefineConstants>
		</PropertyGroup>
		<PropertyGroup Condition="'@(_MockolateMSTest4Reference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_MSTEST</DefineConstants>
		</PropertyGroup>
		<PropertyGroup Condition="'@(_MockolateMSTest3Reference)' != ''">
			<DefineConstants>$(DefineConstants);MOCKOLATE_TEST_FRAMEWORK;MOCKOLATE_MSTEST;MOCKOLATE_MSTEST3</DefineConstants>
		</PropertyGroup>
	</Target>

</Project>
