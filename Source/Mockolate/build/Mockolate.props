<Project>

	<!-- Lets the Mockolate source generator read the MockolateDisableUnionParameters property of the consuming project.
	     Set it to true to keep the classic matcher/value overloads even when the project compiles with C# 15. -->
	<ItemGroup>
		<CompilerVisibleProperty Include="MockolateDisableUnionParameters"/>
		<!-- Names the attributes the project already gets from another generator, so Mockolate does not polyfill them:
		     "false" stands for OverloadResolutionPriorityAttribute, CallerArgumentExpressionAttribute and
		     ModuleInitializerAttribute (what PolySharp ships); otherwise a ';'-separated list of attribute names
		     (UnionAttribute, OverloadResolutionPriorityAttribute, CallerArgumentExpressionAttribute,
		     ModuleInitializerAttribute). -->
		<CompilerVisibleProperty Include="MockolateUnionAttributePolyfills"/>
		<!-- Set it to true to generate no mocks for the interfaces that mocked members return, so that
		     mocks return null for them instead of an auto-mock. -->
		<CompilerVisibleProperty Include="MockolateSkipAutoMocking"/>
		<!-- A ';'-separated list of namespaces whose interfaces (also in nested namespaces) get no mock for
		     auto-mocking unless the project creates one with CreateMock. -->
		<CompilerVisibleProperty Include="MockolateAutoMockingExcludedNamespaces"/>
		<!-- A ';'-separated list of namespaces whose interfaces (also in nested namespaces) are auto-mocked although
		     they lie in an excluded namespace or in the System, Microsoft or Windows namespaces. -->
		<CompilerVisibleProperty Include="MockolateAutoMockingIncludedNamespaces"/>
	</ItemGroup>

	<PropertyGroup>
		<MockolateAutoMockingIncludedNamespaces Condition="'$(MockolateAutoMockingIncludedNamespaces)' == ''">System.IO.Abstractions</MockolateAutoMockingIncludedNamespaces>
	</PropertyGroup>

</Project>
