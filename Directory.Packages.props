<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="IsExternalInit" Version="1.0.3"/>
		<PackageVersion Include="Nullable" Version="1.3.1"/>
		<PackageVersion Include="System.Memory" Version="4.6.3"/>
	</ItemGroup>
	<ItemGroup>
		<!-- Transitive pins: patched versions for GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6 and GHSA-c399-9853-6jmj -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
		<PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Fallout.Common" Version="10.5.0"/>
		<PackageVersion Include="Fallout.Components" Version="10.5.0"/>
		<!-- Transitive pins: raise the versions Fallout pulls in (SharpCompress 0.50.1, NuGet.Frameworks 7.9.0) -->
		<PackageVersion Include="SharpCompress" Version="0.50.11"/>
		<PackageVersion Include="NuGet.Frameworks" Version="8.0.0"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Meziantou.Analyzer" Version="2.0.163"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4"/>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
		<PackageVersion Include="TUnit.Engine" Version="1.87.12"/>
		<PackageVersion Include="xunit.core" Version="2.9.3"/>
		<PackageVersion Include="xunit.runner.utility" Version="2.9.3"/>
		<PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3"/>
		<PackageVersion Include="NUnit" Version="4.6.1"/>
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.1"/>
		<PackageVersion Include="MSTest.TestAdapter" Version="4.5.3"/>
		<PackageVersion Include="MSTest.TestFramework" Version="4.5.3"/>
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3"/>
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
		<PackageVersion Include="aweXpect.Snapshots" Version="4.3.0"/>
		<PackageVersion Include="aweXpect.Snapshots.DiffEngine" Version="4.3.0"/>
		<PackageVersion Include="aweXpect.Snapshots.PublicApi" Version="4.3.0"/>
		<PackageVersion Include="aweXpect" Version="4.3.0"/>
		<PackageVersion Include="aweXpect.Chronology" Version="1.3.0"/>
		<PackageVersion Include="aweXpect.Mockolate" Version="4.0.0"/>
		<PackageVersion Include="Testably.Abstractions" Version="10.4.0"/>
		<PackageVersion Include="Azure.Data.Tables" Version="12.13.0"/>
		<PackageVersion Include="Azure.Storage.Blobs" Version="12.30.2"/>
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.15"/>
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15"/>
	</ItemGroup>
	<ItemGroup>
		<PackageVersion Include="Moq" Version="4.21.0"/>
		<PackageVersion Include="NSubstitute" Version="6.2.0"/>
		<PackageVersion Include="FakeItEasy" Version="9.0.1"/>
		<PackageVersion Include="TUnit.Mocks" Version="1.87.12"/>
		<PackageVersion Include="Imposter" Version="1.0.13"/>
	</ItemGroup>
</Project>
