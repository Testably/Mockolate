<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Mockolate.SourceGenerators\Mockolate.SourceGenerators.csproj"/>
		<ProjectReference Include="..\..\Source\Mockolate\Mockolate.csproj"/>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"/>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="$(MinimumRoslynVersion)"/>
	</ItemGroup>

	<!-- Stays on xunit v2: the coverlet collector cannot reliably read the coverage hits of xunit.v3's
	     out-of-process runs (intermittent EndOfStreamException at session end), which silently drops the
	     whole generator coverage from the SonarCloud quality gate. -->

	<ItemGroup>
		<Compile Remove="Snapshot\Expected\**"/>
		<None Include="Snapshot\Expected\**"/>
	</ItemGroup>

</Project>
