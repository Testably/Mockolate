<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props"
			Condition="Exists('$(MSBuildThisFileDirectory)/../Directory.Build.props')"/>

	<PropertyGroup>
		<TargetFrameworks>net11.0;net10.0;net8.0;net48</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>701;1702;CA1845</NoWarn>
		<!--
			The .NET 11 SDK writes a runtimeconfig.dev.json (hot reload options, no probing paths) for Debug builds.
			VsTest 18.0.1 (bundled with Stryker) then fails on Linux with a NullReferenceException while looking for
			testhost.dll, so no tests are discovered during mutation testing.
		-->
		<GenerateRuntimeConfigDevFile>false</GenerateRuntimeConfigDevFile>
	</PropertyGroup>

	<!--
	    The tests run on TUnit as executables of the Microsoft.Testing.Platform. TUnit discovers them through
	    reflection instead of its source generator, which keeps the compilation of the large test projects fast.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
		<!-- The polyfills of TUnit clash with the internal polyfills of Mockolate, which the tests can see. -->
		<EnableTUnitPolyfills>false</EnableTUnitPolyfills>
	</PropertyGroup>

	<!-- Project references do not import the package props, so make the generator see the property here too. -->
	<Import Project="$(MSBuildThisFileDirectory)/../Source/Mockolate/build/Mockolate.props"/>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<!-- Compiles with C# 15 unions, so the union-typed setup surface is exercised on this target. -->
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit.Engine"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
		<PackageReference Include="aweXpect"/>
		<PackageReference Include="aweXpect.Chronology"/>
		<PackageReference Include="aweXpect.Mockolate"/>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Net.Http"/>
	</ItemGroup>

	<!-- TUnit runs its netstandard2.0 build on net8.0, which references Microsoft.Bcl.AsyncInterfaces without declaring it. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
	</ItemGroup>

	<ItemGroup>
		<Using Include="TUnit.Core"/>
	</ItemGroup>

</Project>
