<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props"
			Condition="Exists('$(MSBuildThisFileDirectory)/../Directory.Build.props')"/>

	<PropertyGroup>
		<TargetFrameworks>net11.0;net10.0;net8.0;net48</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>701;1702;CA1845</NoWarn>
	</PropertyGroup>

	<!--
	    The tests run on TUnit as executables of the Microsoft.Testing.Platform. TUnit discovers them through
	    reflection instead of its source generator, which keeps the compilation of the large test projects fast.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
		<!-- The polyfills of TUnit clash with the internal polyfills of Mockolate, which the tests can see. -->
		<EnableTUnitPolyfills>false</EnableTUnitPolyfills>
	</PropertyGroup>

	<!-- Project references do not import the package props, so make the generator see the property here too. -->
	<Import Project="$(MSBuildThisFileDirectory)/../Source/Mockolate/build/Mockolate.props"/>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<!-- C# 15 unions are still a preview language feature; the union-typed setup surface is opt-in until they ship. -->
		<LangVersion>preview</LangVersion>
		<MockolateUnionParameters>true</MockolateUnionParameters>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit.Engine"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
		<PackageReference Include="aweXpect"/>
		<PackageReference Include="aweXpect.Chronology"/>
		<PackageReference Include="aweXpect.Mockolate"/>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Net.Http"/>
	</ItemGroup>

	<ItemGroup>
		<Using Include="TUnit.Core"/>
	</ItemGroup>

</Project>
