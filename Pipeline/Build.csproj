<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006;CS8632;NU1901;NU1902;NU1903</NoWarn>
		<FalloutRootDirectory>..</FalloutRootDirectory>
		<FalloutScriptDirectory>..</FalloutScriptDirectory>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Fallout.Common"/>
		<PackageReference Include="Fallout.Components"/>
	</ItemGroup>

	<ItemGroup>
		<PackageDownload Include="dotnet-sonarscanner" Version="[9.0.2]"/>
		<PackageDownload Include="dotnet-stryker" Version="[5.0.0]"/>
		<PackageDownload Include="GitVersion.Tool" Version="[6.0.5]"/>
		<PackageDownload Include="ReportGenerator" Version="[5.4.1]"/>
	</ItemGroup>

</Project>
